generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum ApplicationStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Application {
  id Int @id @default(autoincrement())
  name String   
  phone String
  course String 
  status ApplicationStatus @default(NEW)
  createdAt DateTime @default(now()) 
}